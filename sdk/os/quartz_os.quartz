	store u32 1825764 #0
	movi u32 #0 215
	store u32 1825768 #0
	movi u32 #0 1329301
	store u32 1825772 #0
	movi u32 #0 17
	store u32 1825776 #0
	movi u32 #0 50752
	store u32 1825780 #0
	call draw_text

	movi u16 #0 280
	movi u16 #1 256

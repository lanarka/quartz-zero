// ============================================================================
// draw_window (P0 = win_base)
// ============================================================================
draw_window:
	load u32 #0 1825764
	store u32 1825836 #0

	mov #1 #0
	addi u32 #1 4
	loadr u32 #2 #1
	store u32 1825840 #2

	mov #1 #0
	addi u32 #1 8
	loadr u32 #2 #1
	store u32 1825844 #2

	// title bar fill
	load u32 #0 1825840
	load u32 #1 1825844
	movi u16 #2 300
	movi u16 #3 26
	movi u32 #4 1438336
	xframe #0 #1 #2 #3 #4

	// body fill
	load u32 #0 1825840
	load u32 #1 1825844
	addi u32 #1 26
	movi u16 #2 300
	movi u16 #3 194
	movi u32 #4 1469536
	xframe #0 #1 #2 #3 #4

	// outer border
	load u32 #0 1825840
	store u32 1825764 #0
	load u32 #0 1825844
	store u32 1825768 #0
	movi u32 #0 300
	store u32 1825772 #0
	movi u32 #0 220
	store u32 1825776 #0
	movi u32 #0 0xFF404040
	store u32 1825780 #0
	call draw_border

	// close box
	load u32 #0 1825840
	addi u32 #0 278
	store u32 1825852 #0
	load u32 #0 1825852
	load u32 #1 1825844
	addi u32 #1 4
	movi u16 #2 18
	movi u16 #3 18
	movi u32 #4 1702336
	xframe #0 #1 #2 #3 #4

	load u32 #0 1825852
	store u32 1825764 #0
	load u32 #0 1825844
	addi u32 #0 4
	store u32 1825768 #0
	movi u32 #0 18
	store u32 1825772 #0
	movi u32 #0 18
	store u32 1825776 #0
	movi u32 #0 0xFF404040
	store u32 1825780 #0
	call draw_border

	load u32 #0 1825852
	addi u32 #0 5
	store u32 1825764 #0
	load u32 #0 1825844
	addi u32 #0 6
	store u32 1825768 #0
	movi u32 #0 88
	store u32 1825772 #0
	movi u32 #0 50752
	store u32 1825776 #0
	call draw_char

	// title text
	load u32 #0 1825836
	addi u32 #0 12
	loadr u32 #1 #0
	store u32 1825848 #1
	cmpi u32 #1 0
	jz dw_title_root

	load u32 #0 1825836
	addi u32 #0 16
	load u32 #1 1825848
	subi u32 #1 1
	movi u32 #2 44
	mul u32 #1 #2
	add u32 #0 #1
	store u32 1825884 #0
	store u32 1825764 #0
	call name_len
	load u32 #1 1825804
	cmpi u32 #1 28
	jle dw_title_lenok
	movi u32 #1 28
dw_title_lenok:
	store u32 1825888 #1
	jmp dw_title_draw

dw_title_root:
	movi u32 #0 1329320
	store u32 1825884 #0
	movi u32 #0 4
	store u32 1825888 #0

dw_title_draw:
	load u32 #0 1825840
	addi u32 #0 8
	store u32 1825764 #0
	load u32 #0 1825844
	addi u32 #0 6
	store u32 1825768 #0
	load u32 #0 1825884
	store u32 1825772 #0
	load u32 #0 1825888
	store u32 1825776 #0
	movi u32 #0 8192
	store u32 1825780 #0
	call draw_text

	// entries
	load u32 #0 1825836
	addi u32 #0 192
	loadr u32 #1 #0
	store u32 1825856 #1

	movi u32 #0 0
	store u32 1825852 #0
dw_row_loop:
	load u32 #0 1825852
	load u32 #1 1825856
	cmp u32 #0 #1
	jge dw_row_done

	// entry_addr = base + WIN_OFF_ENTRIES + i*64
	load u32 #2 1825836
	addi u32 #2 196
	mov #3 #0
	movi u32 #4 64
	mul u32 #3 #4
	add u32 #2 #3
	store u32 1825864 #2

	// row top (absolute) = Y + 30 + i*22
	load u32 #3 1825844
	addi u32 #3 30
	mov #4 #0
	movi u32 #5 22
	mul u32 #4 #5
	add u32 #3 #4
	store u32 1825860 #3

	// attribute
	mov #4 #2
	addi u32 #4 44
	loadr u8 #5 #4
	store u32 1825868 #5

	cmpi u32 #5 1
	jz dw_row_icon_folder

	// not a dir -> check .bin
	load u32 #2 1825864
	store u32 1825764 #2
	call name_len
	load u32 #6 1825804
	store u32 1825880 #6
	load u32 #2 1825864
	store u32 1825764 #2
	store u32 1825768 #6
	call is_bin_ext
	load u32 #6 1825804
	cmpi u32 #6 1
	jz dw_row_icon_gear

	movi u32 #0 95360
	store u32 1825892 #0
	jmp dw_row_icon_done

dw_row_icon_gear:
	movi u32 #0 94336
	store u32 1825892 #0
	jmp dw_row_icon_done

dw_row_icon_folder:
	movi u32 #0 93312
	store u32 1825892 #0
	load u32 #2 1825864
	store u32 1825764 #2
	call name_len
	load u32 #6 1825804
	store u32 1825880 #6

dw_row_icon_done:
	load u32 #0 1825840
	addi u32 #0 8
	load u32 #1 1825860
	addi u32 #1 2
	movi u16 #2 16
	movi u16 #3 16
	load u32 #4 1825892
	xframe #0 #1 #2 #3 #4

	load u32 #6 1825880
	cmpi u32 #6 30
	jle dw_row_namelen_ok
	movi u32 #6 30
dw_row_namelen_ok:

	load u32 #0 1825840
	addi u32 #0 30
	store u32 1825764 #0
	load u32 #0 1825860
	addi u32 #0 4
	store u32 1825768 #0
	load u32 #0 1825864
	store u32 1825772 #0
	store u32 1825776 #6
	movi u32 #0 50752
	store u32 1825780 #0
	call draw_text

	load u32 #0 1825852
	inc u32 #0
	store u32 1825852 #0
	jmp dw_row_loop
dw_row_done:
	ret

// ============================================================================
// draw_about: "Quartz OS 1.0" / [OK] - reuses the same box+button chrome as
// draw_msgbox.
// ============================================================================
draw_about:
	movi u16 #0 190
	movi u16 #1 185
	movi u16 #2 260
	movi u16 #3 110
	movi u32 #4 1703632
	xframe #0 #1 #2 #3 #4

	movi u32 #0 190
	store u32 1825764 #0
	movi u32 #0 185
	store u32 1825768 #0
	movi u32 #0 260
	store u32 1825772 #0
	movi u32 #0 110
	store u32 1825776 #0
	movi u32 #0 0xFF808080
	store u32 1825780 #0
	call draw_border

	movi u32 #0 268
	store u32 1825764 #0
	movi u32 #0 215
	store u32 1825768 #0
	movi u32 #0 1329324
	store u32 1825772 #0
	movi u32 #0 13
	store u32 1825776 #0
	movi u32 #0 50752
	store u32 1825780 #0
	call draw_text

	movi u16 #0 280
	movi u16 #1 256
	movi u16 #2 80
	movi u16 #3 24
	movi u32 #4 1818032
	xframe #0 #1 #2 #3 #4

	movi u32 #0 280
	store u32 1825764 #0
	movi u32 #0 256
	store u32 1825768 #0
	movi u32 #0 80
	store u32 1825772 #0
	movi u32 #0 24
	store u32 1825776 #0
	movi u32 #0 0xFF808080
	store u32 1825780 #0
	call draw_border

	movi u32 #0 312
	store u32 1825764 #0
	movi u32 #0 261
	store u32 1825768 #0
	movi u32 #0 1329318
	store u32 1825772 #0
	movi u32 #0 2
	store u32 1825776 #0
	movi u32 #0 50752
	store u32 1825780 #0
	call draw_text
	ret

// ============================================================================
// name_len (P0=addr) -> R0 = length of NUL-terminated string, capped at 43
// ============================================================================
name_len:
	load u32 #0 1825764
	movi u32 #1 0
nl_loop:
	cmpi u32 #1 43
	jge nl_done
	mov #2 #0
	add u32 #2 #1
	loadr u8 #3 #2
	cmpi u32 #3 0
	jz nl_done
	inc u32 #1
	jmp nl_loop
nl_done:
	store u32 1825804 #1
	ret

// ============================================================================
// is_bin_ext (P0=addr, P1=len) -> R0 = 1 if the name ends in ".bin"
// ============================================================================
is_bin_ext:
	load u32 #0 1825768
	cmpi u32 #0 4
	jl ib_no
	load u32 #1 1825764
	mov #2 #0
	subi u32 #2 4
	add u32 #2 #1
	loadr u8 #3 #2
	cmpi u32 #3 46
	jnz ib_no
	mov #4 #2
	addi u32 #4 1
	loadr u8 #3 #4
	cmpi u32 #3 98
	jnz ib_no
	mov #4 #2
	addi u32 #4 2
	loadr u8 #3 #4
	cmpi u32 #3 105
	jnz ib_no
	mov #4 #2
	addi u32 #4 3
	loadr u8 #3 #4
	cmpi u32 #3 110
	jnz ib_no
	movi u32 #5 1
	store u32 1825804 #5
	ret
ib_no:
	movi u32 #5 0
	store u32 1825804 #5
	ret

// ============================================================================
// svfs_goto (P0 = win_base) - navigates SVFS's global current directory to
// this window's absolute path (cd "/" then cd each stored path component)
// ============================================================================
svfs_goto:
	load u32 #0 1825764
	store u32 1825900 #0

	movi u32 #1 1329337
	fscd #1 #2

	load u32 #0 1825900
	addi u32 #0 12
	loadr u32 #1 #0
	store u32 1825904 #1

	movi u32 #2 0
	store u32 1825908 #2
sg_loop:
	load u32 #0 1825908
	load u32 #1 1825904
	cmp u32 #0 #1
	jge sg_done

	load u32 #2 1825900
	addi u32 #2 16
	mov #3 #0
	movi u32 #4 44
	mul u32 #3 #4
	add u32 #2 #3
	fscd #2 #5

	load u32 #0 1825908
	inc u32 #0
	store u32 1825908 #0
	jmp sg_loop
sg_done:
	ret

// ============================================================================
// find_free_slot -> R0 = window-table index 0..3, or 0xFFFFFFFF if full
// ============================================================================
find_free_slot:
	movi u32 #0 0
fs_loop:
	cmpi u32 #0 4
	jge fs_none
	mov #1 #0
	movi u32 #2 708
	mul u32 #1 #2
	movi u32 #3 1826408
	add u32 #3 #1
	loadr u32 #4 #3
	cmpi u32 #4 0
	jz fs_found
	inc u32 #0
	jmp fs_loop
fs_found:
	store u32 1825804 #0
	ret
fs_none:
	movi u32 #5 0xFFFFFFFF
	store u32 1825804 #5
	ret

// ============================================================================
// open_root_window - opens a new explorer window on the disk root "/"
// ============================================================================
open_root_window:
	call find_free_slot
	load u32 #0 1825804
	cmpi u32 #0 0xFFFFFFFF
	jz orw_none
	store u32 1825948 #0

	mov #1 #0
	movi u32 #2 708
	mul u32 #1 #2
	movi u32 #3 1826408
	add u32 #3 #1
	store u32 1825944 #3

	load u32 #0 1825948
	mov #4 #0
	movi u32 #5 30
	mul u32 #4 #5
	addi u32 #4 60
	load u32 #3 1825944
	mov #6 #3
	addi u32 #6 4
	storer u32 #6 #4

	load u32 #0 1825948
	mov #4 #0
	movi u32 #5 25
	mul u32 #4 #5
	addi u32 #4 50
	load u32 #3 1825944
	mov #6 #3
	addi u32 #6 8
	storer u32 #6 #4

	load u32 #3 1825944
	mov #6 #3
	addi u32 #6 12
	movi u32 #7 0
	storer u32 #6 #7

	load u32 #3 1825944
	store u32 1825764 #3
	call svfs_goto

	load u32 #3 1825944
	mov #0 #3
	addi u32 #0 196
	movi u32 #1 8
	fsdir #0 #1 #2 #6

	load u32 #3 1825944
	mov #4 #3
	addi u32 #4 192
	storer u32 #4 #2

	load u32 #3 1825944
	mov #4 #3
	addi u32 #4 0
	movi u32 #5 1
	storer u32 #4 #5
orw_none:
	ret

// ============================================================================
// open_sub_window (P0 = parent_win_base, P1 = entry_index) - opens a new
// window for the sub-directory named by entries[entry_index] of the parent.
// ============================================================================
open_sub_window:
	load u32 #0 1825764
	store u32 1825916 #0
	load u32 #0 1825768
	store u32 1825920 #0

	call find_free_slot
	load u32 #0 1825804
	cmpi u32 #0 0xFFFFFFFF
	jz osw_none
	store u32 1825940 #0

	mov #1 #0
	movi u32 #2 708
	mul u32 #1 #2
	movi u32 #3 1826408
	add u32 #3 #1
	store u32 1825924 #3

	// parent depth
	load u32 #0 1825916
	addi u32 #0 12
	loadr u32 #1 #0
	store u32 1825932 #1

	// if parent depth already at max (4), refuse (no room for another level)
	cmpi u32 #1 4
	jge osw_none

	// copy parent path[0..pdepth-1] into dst path
	load u32 #0 1825916
	addi u32 #0 16
	load u32 #2 1825924
	addi u32 #2 16
	mov #3 #1
	movi u32 #4 44
	mul u32 #3 #4
	memcpy #2 #0 #3

	// copy the chosen entry's name (44 bytes) into dst.path[pdepth]
	load u32 #0 1825916
	addi u32 #0 196
	load u32 #4 1825920
	mov #5 #4
	movi u32 #6 64
	mul u32 #5 #6
	add u32 #0 #5
	store u32 1825936 #0

	load u32 #2 1825924
	addi u32 #2 16
	load u32 #1 1825932
	mov #5 #1
	movi u32 #6 44
	mul u32 #5 #6
	add u32 #2 #5
	load u32 #0 1825936
	movi u32 #6 44
	memcpy #2 #0 #6

	// dst.depth = pdepth+1
	load u32 #1 1825932
	inc u32 #1
	load u32 #2 1825924
	addi u32 #2 12
	storer u32 #2 #1

	// position based on slot index
	load u32 #0 1825940
	mov #4 #0
	movi u32 #5 30
	mul u32 #4 #5
	addi u32 #4 60
	load u32 #2 1825924
	mov #6 #2
	addi u32 #6 4
	storer u32 #6 #4

	load u32 #0 1825940
	mov #4 #0
	movi u32 #5 25
	mul u32 #4 #5
	addi u32 #4 50
	load u32 #2 1825924
	mov #6 #2
	addi u32 #6 8
	storer u32 #6 #4

	// navigate + list
	load u32 #2 1825924
	store u32 1825764 #2
	call svfs_goto

	load u32 #2 1825924
	mov #0 #2
	addi u32 #0 196
	movi u32 #1 8
	fsdir #0 #1 #3 #6

	load u32 #2 1825924
	mov #4 #2
	addi u32 #4 192
	storer u32 #4 #3

	load u32 #2 1825924
	mov #4 #2
	addi u32 #4 0
	movi u32 #5 1
	storer u32 #4 #5
osw_none:
	ret

// ============================================================================
// execute_bin (P0 = win_base, P1 = entry_index) - loads and runs a .bin
// file found in this window's directory, via a "warm restart" (vmx),
// exactly like loader.quartz, with a hardcoded entrypoint of 0x00000000.
// ============================================================================
execute_bin:
	load u32 #0 1825764
	store u32 1825952 #0
	load u32 #0 1825768
	store u32 1825956 #0

	load u32 #0 1825952
	store u32 1825764 #0
	call svfs_goto

	load u32 #0 1825952
	addi u32 #0 196
	load u32 #1 1825956
	mov #2 #1
	movi u32 #3 64
	mul u32 #2 #3
	add u32 #0 #2
	store u32 1825960 #0

	ramsize #1
	store u32 1825964 #1
	movi u32 #2 1835008

	// safety guard: need at least a few KB of room past BIN_LOAD_ADDR for
	// any real program, otherwise bail out instead of calling vmx with a
	// zero/garbage length (which would fault the whole VM)
	mov #3 #2
	addi u32 #3 4096
	cmp u32 #1 #3
	jl ex_ret


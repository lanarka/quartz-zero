// --- banner + disk check -------------------------------------------------

	movi u32 #15 6003
	call print_string

	fsatt #0
	cmpi u32 #0 0
	jnz main_loop
	movi u32 #15 6021
	call print_string


// =============================================================================
// main_loop - print the prompt, read a line, parse it and run the command
// =============================================================================

main_loop:
	movi u32 #15 6000
	call print_string
	call read_line
	xtcurset #10 #11

	// --- find the first space in the line, split into cmd (addr. 300) and arg -------
	movi u32 #2 300
find_space_loop:
	loadr u8 #3 #2
	cmpi u8 #3 0
	jz split_no_space
	cmpi u8 #3 32
	jz split_found_space
	inc u32 #2
	jmp find_space_loop
split_found_space:
	movi u8 #3 0
	storer u8 #2 #3
	mov #1 #2
	inc u32 #1                  // #1 = arg_addr (character after the space)
	jmp split_done
split_no_space:
	mov #1 #2                   // no argument -> #1 = address of the trailing NUL
split_done:

	// --- build an 8-byte, zero-filled "cmdbuf" for comparison ----------
	// (#5,#6 are now permanently reserved for caps_on/caps_prev_held, so here
	// we only use #0,#2,#4 - #1 must stay untouched, it holds arg_addr)
	movi u32 #0 250
	movi u32 #2 0
	movi u32 #4 8
	memset #0 #2 #4

	load u8 #3 300
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 250 #3
	load u8 #3 301
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 251 #3
	load u8 #3 302
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 252 #3
	load u8 #3 303
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 253 #3
	load u8 #3 304
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 254 #3
	load u8 #3 305
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 255 #3
	load u8 #3 306
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 256 #3
	load u8 #3 307
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 257 #3
cmdbuf_done:

	// --- compare the whole 8-byte "cmdbuf" at once as a single u64 number ---
	load u64 #0 250

	cmpi u64 #0 0
	jz do_empty
	cmpi u64 #0 0x726964
	jz do_dir
	cmpi u64 #0 0x7269646B6D
	jz do_mkdir
	cmpi u64 #0 0x6472
	jz do_rd
	cmpi u64 #0 0x6463
	jz do_cd
	cmpi u64 #0 0x6C6564
	jz do_del
	cmpi u64 #0 0x65707974
	jz do_type
	cmpi u64 #0 0x6E7572
	jz do_run
	cmpi u64 #0 0x736C63
	jz do_cls
	cmpi u64 #0 0x706C6568
	jz do_help
	cmpi u64 #0 0x74697865
	jz do_exit
	jmp do_unknown


// --- DIR ---------------------------------------------------------------------
// (#5,#6 are permanently reserved for caps_on/caps_prev_held - so this
// section only uses #0-#4; #1 (arg_addr) is free here, DIR has no argument)
do_dir:
	movi u32 #0 2000             // buf_addr
	movi u32 #1 20                // max_entries
	fsdir #0 #1 #2 #3             // #2=dst_count, #3=status
	cmpi u32 #3 0
	jz dir_nodisk
	movi u32 #4 0                 // entry index
dir_loop:
	cmp u32 #4 #2
	jge dir_done
	mov #1 #4
	movi u32 #0 64
	mul u32 #1 #0
	addi u32 #1 2000              // #1 = address of the current record
	mov #15 #1
	call print_string             // print the name (offset 0..43 in the record)
	mov #0 #1
	addi u32 #0 44                // attribute offset
	loadr u8 #3 #0                // #3 = attribute (status no longer needed)
	cmpi u8 #3 1
	jnz dir_file
	movi u32 #15 6146
	call print_string
	jmp dir_next
dir_file:
	movi u32 #15 6154
	call print_string
dir_next:
	inc u32 #4
	jmp dir_loop
dir_nodisk:
	movi u32 #15 6042
	call print_string
dir_done:
	jmp main_loop


// --- MKDIR <name> --------------------------------------------------------------
do_mkdir:
	fsmkdir #1
	jmp main_loop


// --- RD <name> (rmdir, non-recursive) --------------------------------------------
do_rd:
	movi u32 #0 0
	fsrmdir #1 #0
	jmp main_loop


// --- CD <name> -------------------------------------------------------------
do_cd:
	fscd #1 #2
	cmpi u32 #2 0
	jnz main_loop
	movi u32 #15 6087
	call print_string
	jmp main_loop


// --- DEL <name> --------------------------------------------------------------
do_del:
	fsrm #1
	jmp main_loop


// --- TYPE <name> ---------------------------------------------------------------
do_type:
	fsopen #1
	movi u32 #2 4000
	movi u32 #3 1024
	fsread #1 #2 #3 #4 #0        // buf=#2, buf_size=#3, dst_len=#4, status=#0
	fsclose #1
	cmpi u32 #0 0
	jz type_fail
	mov #15 #2
	call print_string
	movi u16 #14 10
	call print_char
	jmp main_loop
type_fail:
	movi u32 #15 6105
	call print_string
	jmp main_loop


// --- RUN <name> - loads a raw binary file and runs it via vmx -----------
// the entrypoint is hardcoded to 0x00000000 (as the user explicitly wanted)
do_run:
	loadr u8 #2 #1
	cmpi u8 #2 0
	jz run_fail                  // no argument
	fsopen #1
	ramsize #0
	movi u32 #2 8192              // code_addr - where the file contents are loaded
	mov #3 #0
	sub u32 #3 #2                 // buf_size = ramsize - code_addr
	fsreadb #1 #2 #3 #4 #0        // #4 = dst_len, status -> #0 (ramsize no longer needed)
	fsclose #1
	cmpi u32 #4 0
	jz run_fail
	movi u32 #0 0                 // entrypoint = 0x00000000 (hardcoded)
	vmx #2 #4 #0                  // if it succeeds, control never returns here
run_fail:
	movi u32 #15 6121
	call print_string
	jmp main_loop


// --- CLS -----------------------------------------------------------------------
do_cls:
	xtclear
	movi u16 #10 0
	movi u16 #11 0
	jmp main_loop


// --- HELP ------------------------------------------------------------------
do_help:
	movi u32 #15 6156
	call print_string
	jmp main_loop


// --- EXIT --------------------------------------------------------------------
do_exit:
	halt


// --- empty line (Enter with no command) -> just show the prompt again -----------------
do_empty:
	jmp main_loop


// --- unknown commands ---------------------------------------------------------
do_unknown:
	movi u32 #15 6061
	call print_string
	jmp main_loop


// =============================================================================
// print_char - draws one character and advances the cursor (#10,#11)
//   input:  #14 = character code point (10 = newline)
//   uses only #10,#11 (persistent) and #12,#13 (colors, read-only)
// =============================================================================
print_char:
	cmpi u16 #14 10
	jz pc_newline

	xtchar #10 #11 #14 #12 #13
	inc u16 #10
	cmp u16 #10 #9
	jl pc_check_row
	movi u16 #10 0
	inc u16 #11
	jmp pc_check_row

pc_newline:
	movi u16 #10 0
	inc u16 #11

pc_check_row:
	cmp u16 #11 #8
	jl pc_done
	movi u16 #11 0               // no real scrolling - wrap to the top

pc_done:
	xtcurset #10 #11
	ret


// =============================================================================
// print_string - prints a NUL-terminated string
//   input:  #15 = address of the string (modified during execution - treat as scratch)
//   uses #14 (via print_char) and #15
// =============================================================================
print_string:
	loadr u8 #14 #15
	cmpi u8 #14 0
	jz ps_done
	call print_char
	inc u32 #15
	jmp print_string
ps_done:
	ret


// =============================================================================
// classify_key - evaluates one physical key code (RAYLIB 5.5) while
// scanning all 4 slots from xikey.
//   input:  #4 = key code (one of the 4 slots read by the caller)
//   output: #2 = shift_flag - set to 1 if it was KEY_LEFT/RIGHT_SHIFT
//           #3 = primary_key - set to #4, IF it hasn't been set yet
//                (i.e. #3==0) and #4 is not a modifier (shift/ctrl/alt/super/
//                capslock/menu) nor 0
//   the caller must zero #2 and #3 BEFORE the first call (they accumulate
//   across multiple calls - 4x, once for each slot)
// =============================================================================
classify_key:
	cmpi u32 #4 340               // KEY_LEFT_SHIFT
	jz ck_shift
	cmpi u32 #4 344               // KEY_RIGHT_SHIFT
	jz ck_shift
	cmpi u32 #4 0
	jz ck_done
	cmpi u32 #4 280               // KEY_CAPS_LOCK - handled separately
	jz ck_done
	cmpi u32 #4 341               // KEY_LEFT_CONTROL
	jz ck_done
	cmpi u32 #4 342               // KEY_LEFT_ALT
	jz ck_done
	cmpi u32 #4 343               // KEY_LEFT_SUPER
	jz ck_done
	cmpi u32 #4 345               // KEY_RIGHT_CONTROL
	jz ck_done
	cmpi u32 #4 346               // KEY_RIGHT_ALT
	jz ck_done
	cmpi u32 #4 347               // KEY_RIGHT_SUPER
	jz ck_done
	cmpi u32 #4 348               // KEY_KB_MENU
	jz ck_done
	cmpi u32 #3 0
	jnz ck_done                    // primary_key was already found in an earlier slot
	mov #3 #4
	jmp ck_done
ck_shift:
	movi u32 #2 1
ck_done:
	ret


// =============================================================================
// read_line - reads one line from the keyboard into RAM at address 300
// (max 62 characters + NUL), with echo to the screen, BACKSPACE, typematic
// auto-repeat, and SHIFT / CAPS LOCK support (upper/lowercase letters).
//
// Key codes are physical codes according to RAYLIB 5.5 - xikey reports up to
// 4 SIMULTANEOUSLY held codes at once (not just one), so e.g. Shift+D brings,
// within a single poll, both 340 (shift) and 68 ('d') in two different
// slots. So every frame all 4 slots (RAM 200,202,204,206) are scanned:
//   - Phase A: looks for KEY_CAPS_LOCK(280) - an edge (0->1) toggles caps_on (#5)
//   - Phase B: classify_key determines shift_flag (#2) and "primary_key" (#3)
//             - the first non-trivial, non-modifier code found
// The resulting letter (65-90) is printed UPPERCASE if (shift XOR caps_on)==1,
// otherwise lowercase (+32). Digits/space/punctuation are unchanged (Shift has
// no effect on them - shifted symbols like '!' for Shift+1 are not known by
// this shell).
//
//   uses #0-#4(scratch/local), #5/#6(caps_on/caps_prev_held - permanently
//   reserved), #7(prev_key), #14(via print_char), #15(via print_string)
// =============================================================================
read_line:
	movi u32 #0 300
	movi u32 #1 0
	movi u32 #2 64
	memset #0 #1 #2

	movi u32 #0 0                // #0 = current line length
	// NOTE: #7 (prev_key) is DELIBERATELY not reset HERE - it is a persistent
	// register set once when the program starts. If it were reset on every
	// read_line call, then e.g. Enter (or any other key) which is still
	// physically held down even in the first frame of a new read_line would
	// be evaluated again as a "new" key press - and the whole line
	// (including an empty Enter) would be processed multiple times in a row
	// until the user actually releases the key. #5/#6 (caps) are for the
	// same reason also persistent and are reset only once, at program startup.

rl_loop:
	xvsync 0

	movi u32 #2 200
	xikey #3 #2                    // fills RAM 200-207 with the current keyboard
	                                // state (we don't need the count in #3 here,
	                                // it will be overwritten right away by Phase A)

	// --- Phase A: Caps Lock - an edge 0->1 toggles caps_on (#5) -----------------
	// The Caps Lock key now (after the fix in the VM - rt_keyboard in
	// runtime.c) reports via xikey code 280 as a CLEAN one-shot "pressed"
	// pulse for exactly one frame on EVERY physical press (both turning it on
	// and off), so the same, already-proven pattern as for ENTER/BACKSPACE
	// can be used - toggle only on the rising edge 0->1, NOT on "release"
	// (which here is actually just the end of that one-frame pulse).
	movi u32 #4 0                 // #4 = caps_held_now (accumulator)
	load u16 #3 200
	cmpi u32 #3 280                // KEY_CAPS_LOCK
	jnz capA_1
	movi u32 #4 1
capA_1:
	load u16 #3 202
	cmpi u32 #3 280
	jnz capA_2
	movi u32 #4 1
capA_2:
	load u16 #3 204
	cmpi u32 #3 280
	jnz capA_3
	movi u32 #4 1
capA_3:
	load u16 #3 206
	cmpi u32 #3 280
	jnz capA_4
	movi u32 #4 1
capA_4:
	cmp u32 #4 #6
	jz capA_done                   // no change in the Caps Lock held state
	mov #6 #4                      // remember the new state
	cmpi u32 #4 0
	jz capA_done                   // it was a RELEASE - don't toggle (toggle
	                                // only on press, exactly like a normal
	                                // key)
	movi u32 #3 1
	xor u32 #5 #3                  // toggle caps_on
capA_done:

	// --- Phase B: shift_flag (#2) and primary_key (#3) from all 4 slots ---
	movi u32 #2 0
	movi u32 #3 0
	load u16 #4 200
	call classify_key
	load u16 #4 202
	call classify_key
	load u16 #4 204
	call classify_key
	load u16 #4 206
	call classify_key
	// at this point: #2 = shift_flag, #3 = primary_key (0 = nothing typeable is held)

	cmpi u32 #3 0
	jz rl_release

	cmp u32 #3 #7
	jz rl_held                     // same key as last frame ->
	                                // typematic repeat below

	// --- new press (a different code than last frame) -> always fire immediately ------
	mov #7 #3
	movi u32 #1 30                 // #1 = repeat_timer, initial delay
	jmp rl_apply_case

	// --- the same key is held for another frame -> typematic auto-repeat ----
	// KEY_REPEAT_DELAY = 30 frames (approx. 0.5s at 60 FPS) before the repeat
	// starts KEY_REPEAT_RATE  = 4 frames (approx. 15 chars/s) between
	// individual repeats. Both figures assume ~60 FPS (--fps 60, the VM's
	// default value); with a different --fps the timing changes proportionally.
rl_held:
	dec u32 #1
	cmpi u32 #1 0
	jg rl_loop                     // still within the countdown
	movi u32 #1 4                  // next repeat tick in 4 frames
	// falls through into rl_apply_case - this is exactly the frame in which
	// the character should be repeated

rl_apply_case:
	cmpi u32 #3 257                // ENTER
	jz rl_enter
	cmpi u32 #3 259                // BACKSPACE
	jz rl_backspace
	cmpi u32 #3 32
	jl rl_loop
	cmpi u32 #3 90
	jg rl_loop
	cmpi u32 #0 62
	jge rl_loop

	cmpi u32 #3 65
	jl rl_store_char
	cmpi u32 #3 90
	jg rl_store_char
	// it's a letter (physical code 65-90, i.e. the "uppercase" form) - check shift/caps:
	mov #4 #2
	xor u32 #4 #5                  // #4 = shift XOR caps_on (1 = should be UPPERCASE)
	cmpi u32 #4 1
	jz rl_store_char                // already in "uppercase" form, no need to change
	addi u32 #3 32                  // otherwise convert to lowercase

rl_store_char:
	mov #4 #0
	addi u32 #4 300
	storer u8 #4 #3
	inc u32 #0
	mov #14 #3
	call print_char
	jmp rl_loop

rl_backspace:
	cmpi u32 #0 0
	jz rl_loop
	dec u32 #0
	cmpi u16 #10 0
	jz rl_loop
	dec u16 #10
	movi u16 #14 32
	xtchar #10 #11 #14 #12 #13
	xtcurset #10 #11
	jmp rl_loop

rl_enter:
	mov #4 #0
	addi u32 #4 300
	movi u8 #2 0
	storer u8 #4 #2
	movi u16 #14 10
	call print_char
	ret

rl_release:
	movi u32 #7 0
	jmp rl_loop

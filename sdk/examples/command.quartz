// =============================================================================
// command.quartz - a simple command interpreter ("easy DOS") for an SVFS disk
//
// prompt> COMMAND [argument]
//
// Supported commands:
//   DIR              - list the contents of the current directory
//   MKDIR <name>     - create a subdirectory
//   RD <name>        - delete an EMPTY subdirectory
//   CD <name>        - change directory (".." = parent, "/" = root)
//   DEL <name>       - delete a file
//   TYPE <name>      - print a text file to the screen
//   RUN <name>       - loads a raw binary file (no file header, like
//                      boot.bin) and runs it via "vmx" (warm restart),
//                      the entrypoint is HARDCODED to 0x00000000
//   CLS              - clear the screen
//   HELP             - print this list of commands
//   EXIT             - stop the VM (halt)
//
// Keyboard: the VM reads physical key codes exactly as reported by RAYLIB 5.5
// (the GetKeyboardKey function / KeyboardKey enum) - "xikey"/"xipoll" return
// exactly these numbers. Important codes used here:
//   32          KEY_SPACE
//   48-57       KEY_ZERO..KEY_NINE   (match ASCII '0'-'9')
//   65-90       KEY_A..KEY_Z         (match ASCII 'A'-'Z')
//   256         KEY_ESCAPE
//   257         KEY_ENTER
//   258         KEY_TAB
//   259         KEY_BACKSPACE
// Raylib reports the PHYSICAL key code (not the character according to the
// layout). Codes 65-90 (A-Z) are therefore ALWAYS the same "uppercase"
// physical code regardless of whether an uppercase or lowercase letter is
// actually typed - the shell takes care of that itself:
//   - SHIFT (Left/Right) held AT THE SAME TIME as the letter -> UPPERCASE letter
//   - CAPS LOCK is on (toggled by every press of the physical Caps
//     Lock key, exactly like on a real keyboard) -> UPPERCASE letter
//   - Shift + Caps Lock together -> they cancel each other out -> lowercase letter
//     (exactly like on a real keyboard)
//   - otherwise (neither) -> lowercase letter
// xikey reports up to 4 simultaneously held codes at once, so Shift+letter is
// captured within a single poll (more in the comment near read_line below).
// Digits/space/punctuation are NOT changed by Shift (the shell doesn't know
// e.g. Shift+1='!') - this is an intentional simplification, outside the
// scope of the assignment.
//
// NOTE on Caps Lock: the actual hardware Caps Lock key initially behaved
// UNRELIABLY (via xikey, which was based only on IsKeyDown() in rt_keyboard)
// - turning it on could be detected, but turning it off could not. The cause
// was a documented bug in raylib/GLFW: the OS correctly sends the press that
// turns Caps Lock on, but never sends the corresponding release (Scroll Lock
// and Num Lock have the same problem) - see
// https://github.com/raysan5/raylib/issues/4078. This caused
// IsKeyDown(KEY_CAPS_LOCK) inside runtime.c to remain "true" forever after
// the first press. FIXED directly in the VM (runtime.c, the rt_keyboard
// function): instead of relying solely on IsKeyDown(), for these three lock
// keys a separate event queue GetKeyPressed() is additionally read, which
// correctly records EVERY physical press (including the one that turns Caps
// Lock off), and that is used to construct a clean one-shot "press" - exactly
// what the code below sees. Thanks to this fix, Caps Lock now behaves, from
// this program's point of view, exactly like an ordinary key (like the
// previously, temporarily used F1).
//
// LIMITATIONS (for simplicity):
//   - a command accepts at most ONE argument (separated by a single space)
//   - max. line length of 62 characters, the command name is compared using
//     only the first 8 bytes (all supported commands are shorter, so this
//     doesn't matter)
//   - no wildcards (*, ?)
//   - no real text scrolling - once the bottom of the screen is reached, the
//     cursor simply returns to row 0 (overwriting from the top)
//
// Register map:
//   #0-#4   - local/temporary registers (freely usable in each section;
//             no subroutine except read_line/classify_key/print_char/
//             print_string uses them, so they survive a
//             call print_string/print_char).
//             In read_line, additionally #1 = repeat_timer (countdown for
//             typematic auto-repeat of a held key - does NOT need to
//             survive between individual read_line calls, unlike #7/#5/#6).
//   #5      - caps_on - Caps Lock state (0/1). PERSISTENT across the WHOLE
//             run (set once at startup, toggled via XOR on every new
//             press of the physical Caps Lock key).
//   #6      - caps_prev_held - was Caps Lock physically held last frame?
//             PERSISTENT (same reason as #7 - edge detection must
//             survive even across the boundary between read_line calls).
//   #7      - prev_key - the code of the last processed "primary" key
//             (primary_key from classify_key). PERSISTENT across the WHOLE
//             run of the program (set once at startup, NOT on every
//             read_line call) - otherwise a physically still-held key
//             (typically ENTER) would be evaluated as "new" after
//             returning to a new read_line, and the whole line would be
//             processed multiple times.
//   #8      - max_rows of the text grid (constant, xtgetres at startup)
//   #9      - max_cols of the text grid (constant, xtgetres at startup)
//   #10     - cur_x (current cursor column, persistent)
//   #11     - cur_y (current cursor row, persistent)
//   #12     - fg color (constant, white)
//   #13     - bg color (constant, black)
//   #14     - parameter/scratch used EXCLUSIVELY in print_char/read_line
//             (the character to draw)
//   #15     - parameter/scratch used EXCLUSIVELY in print_string/dir_loop
//             (the address of the string to print)
//
// RAM addresses:
//   200        - buffer for xikey (8 bytes: up to 4x u16 key code)
//   250        - "cmdbuf": an 8-byte, zero-filled copy of the command name,
//                used for comparison as a single u64 number (fast and
//                without needing a string-comparison subroutine)
//   300        - the input line (64 bytes, NUL-terminated), the characters
//                typed by the user are written here; after Enter, the first
//                space in it is replaced with a zero -> this produces cmd
//                (at address 300) and arg (at the address after the space)
//   2000       - buffer for fsdir (20 x 64 bytes)
//   4000       - buffer for TYPE (reading a text file, 1024 bytes)
//   8192       - buffer for RUN (raw code of the loaded .bin file;
//                size = the rest of RAM from this address, obtained via
//                ramsize - the same trick as in loader.quartz, so RUN
//                works for a file of any length)
//   6000..     - string literals (prompt, messages, help text)
// =============================================================================


// --- 0) initialization --------------------------------------------------------

	xtclear
	xtgetres #8 #9              // #8 = rows, #9 = cols

	movi u32 #12 0xFFFFFFFF     // fg = white, opaque
	movi u32 #13 0xFF000000     // bg = black, opaque
	movi u16 #10 0              // cur_x = 0
	movi u16 #11 0              // cur_y = 0

	movi u8 #0 2                // 2 = thin blinking cursor
	xtcurena #0
	movi u32 #7 0                // #7 = prev_key, PERSISTENT across the whole run
	                              // (must survive even between individual read_line
	                              // calls, otherwise a held Enter/other key would be
	                              // evaluated as "new" after returning to read_line)
	movi u32 #5 0                // #5 = caps_on (Caps Lock state), PERSISTENT
	movi u32 #6 0                // #6 = caps_prev_held (was Caps Lock physically
	                              // held last frame), PERSISTENT - for edge
	                              // detection (the toggle only happens on a PRESS)


// --- string literals (written once at startup) ---------------------------

	// "prompt" @ 6000
	movi u8 #0 '>'
	store u8 6000 #0
	movi u8 #0 ' '
	store u8 6001 #0

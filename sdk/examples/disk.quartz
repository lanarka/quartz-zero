// =============================================================================
// disk.quartz - a comprehensive test/demo of ALL disk (SVFS) instructions:
// fsmkdir, fsrmdir, fscreate, fsrm, fsopen, fsclose, fswrite, fsread,
// fswriteb, fsreadb, fscd, fsdir.
//
// Run with:  ./quartz program.bin --disk mydisk.img
// (mydisk.img must be pre-formatted, e.g.  svfscli mydisk.img format 64K)
//
// The results (statuses, number of bytes read/written, directory contents...)
// are printed via "print" to the standard output of the VM process (host
// console), so you'll see the output in the terminal where you started the VM.
//
// After the program finishes, check the disk with the CLI tool, e.g.:
//   svfscli mydisk.img ls /
//   svfscli mydisk.img ls /docs
//   svfscli mydisk.img fsck
//
// -----------------------------------------------------------------------------
// Register map used in this program:
//   #0  - scratch byte (used when manually building strings/binary data into RAM)
//   #1  - name_addr   (address of the file/directory name for the current operation)
//   #2  - data_addr   (address of the content for fswrite/fswriteb)
//   #3  - buf_addr    (address of the output buffer for fsread/fsreadb/fsdir)
//   #4  - buf_size / max_entries / len (depends on the instruction)
//   #5  - dst_len / dst_count (how much was actually read/written/found)
//   #6  - status      (1 = success, 0 = failure - the result of almost every fs* instruction)
//   #7  - recursive flag / temporary constant
//   #8  - i (loop index while iterating over fsdir results)
//   #9  - count (loop upper bound - number of entries from fsdir)
//   #10 - rec_addr (address of the current record in the loop: buf_addr + i*64)
//   #11 - value read from the current record (attribute / size)
//   #12 - scratch (i*64 while computing rec_addr)
//   #13 - scratch (temporary address: rec_addr + field offset)
//   #14 - scratch byte (used when comparing the read text with the written text)
//   #15 - "match" flag (1/0) when comparing the read text
//
// RAM addresses used as storage for names/content/buffers (outside the code -
// the VM code runs from a separate segment, these addresses are purely "our"
// data area):
//   100  "docs\0"        (directory)
//   120  "notes.txt\0"   (file - text write/read)
//   140  "data.bin\0"    (file - binary write/read)
//   160  "Hi SVFS!\0"    (text content for fswrite/fsread)
//   180  "..\0"
//   190  "/\0"
//   195  "tmp.txt\0"     (temporary file - fsrm demo)
//   210  "trash\0"       (temporary directory - fsrmdir demo)
//   220  "inner.txt\0"   (file created inside "docs" - fscd demo)
//   300  4 raw bytes  (0x00, 0x01, 0xFE, 0xFF) for fswriteb/fsreadb
//   400  output buffer for fsread (64 B, "text" variant - NUL-terminated)
//   500  output buffer for fsreadb (16 B, binary variant - no NUL)
//   600  output buffer for fsdir (5 records * 64 B = 320 B)
// =============================================================================


// --- building strings/data into RAM (manually, byte by byte) -------------------

	movi u8 #0 'd'
	store u8 100 #0
	movi u8 #0 'o'
	store u8 101 #0
	movi u8 #0 'c'
	store u8 102 #0
	movi u8 #0 's'
	store u8 103 #0
	movi u8 #0 0
	store u8 104 #0

	movi u8 #0 'n'
	store u8 120 #0
	movi u8 #0 'o'
	store u8 121 #0
	movi u8 #0 't'
	store u8 122 #0
	movi u8 #0 'e'
	store u8 123 #0
	movi u8 #0 's'
	store u8 124 #0
	movi u8 #0 '.'
	store u8 125 #0
	movi u8 #0 't'
	store u8 126 #0
	movi u8 #0 'x'
	store u8 127 #0
	movi u8 #0 't'
	store u8 128 #0
	movi u8 #0 0
	store u8 129 #0

	movi u8 #0 'd'
	store u8 140 #0
	movi u8 #0 'a'
	store u8 141 #0
	movi u8 #0 't'
	store u8 142 #0
	movi u8 #0 'a'
	store u8 143 #0
	movi u8 #0 '.'
	store u8 144 #0
	movi u8 #0 'b'
	store u8 145 #0
	movi u8 #0 'i'
	store u8 146 #0
	movi u8 #0 'n'
	store u8 147 #0
	movi u8 #0 0
	store u8 148 #0

	movi u8 #0 'H'
	store u8 160 #0
	movi u8 #0 'i'
	store u8 161 #0
	movi u8 #0 ' '
	store u8 162 #0
	movi u8 #0 'S'
	store u8 163 #0
	movi u8 #0 'V'
	store u8 164 #0
	movi u8 #0 'F'
	store u8 165 #0
	movi u8 #0 'S'
	store u8 166 #0
	movi u8 #0 '!'
	store u8 167 #0
	movi u8 #0 0
	store u8 168 #0

	movi u8 #0 '.'
	store u8 180 #0
	movi u8 #0 '.'
	store u8 181 #0
	movi u8 #0 0
	store u8 182 #0

	movi u8 #0 '/'
	store u8 190 #0
	movi u8 #0 0
	store u8 191 #0

	movi u8 #0 't'
	store u8 195 #0
	movi u8 #0 'm'
	store u8 196 #0
	movi u8 #0 'p'
	store u8 197 #0
	movi u8 #0 '.'
	store u8 198 #0
	movi u8 #0 't'
	store u8 199 #0
	movi u8 #0 'x'
	store u8 200 #0
	movi u8 #0 't'
	store u8 201 #0
	movi u8 #0 0
	store u8 202 #0

	movi u8 #0 't'
	store u8 210 #0
	movi u8 #0 'r'
	store u8 211 #0
	movi u8 #0 'a'
	store u8 212 #0
	movi u8 #0 's'
	store u8 213 #0
	movi u8 #0 'h'
	store u8 214 #0
	movi u8 #0 0
	store u8 215 #0

	movi u8 #0 'i'
	store u8 220 #0
	movi u8 #0 'n'
	store u8 221 #0
	movi u8 #0 'n'
	store u8 222 #0
	movi u8 #0 'e'
	store u8 223 #0
	movi u8 #0 'r'
	store u8 224 #0
	movi u8 #0 '.'
	store u8 225 #0
	movi u8 #0 't'
	store u8 226 #0
	movi u8 #0 'x'
	store u8 227 #0
	movi u8 #0 't'
	store u8 228 #0
	movi u8 #0 0
	store u8 229 #0

	// 4 raw bytes for binary write/read (00, 01, FE, FF)
	movi u8 #0 0x00
	store u8 300 #0
	movi u8 #0 0x01
	store u8 301 #0
	movi u8 #0 0xFE
	store u8 302 #0
	movi u8 #0 0xFF
	store u8 303 #0


// --- 1) FSMKDIR: create the "docs" directory at the root -----------------------------

	movi u32 #1 100          // #1 = address of "docs"
	fsmkdir #1
	// fsmkdir has no status register (just like svfs_mkdir()) - success/
	// failure is only visible on stderr, so we print nothing here.


// --- 2) FSCREATE + FSOPEN + FSWRITE + FSCLOSE: text write to a file ------

	movi u32 #1 120          // #1 = address of "notes.txt"
	fscreate #1

	fsopen #1
	movi u32 #2 160          // #2 = address of "Hi SVFS!" (content)
	fswrite #1 #2 #6         // writes the text, #6 = status (1/0)
	print u32 #6             // expected: 1
	fsclose #1


// --- 3) FSOPEN + FSREAD + FSCLOSE: read the text back ------------------

	fsopen #1
	movi u32 #3 400          // #3 = buf_addr (output buffer)
	movi u32 #4 64           // #4 = buf_size
	fsread #1 #3 #4 #5 #6    // #5 = dst_len, #6 = status
	print u32 #5             // expected: 8 (length of "Hi SVFS!")
	print u32 #6             // expected: 1
	fsclose #1

	// Compare the read text with the written one (first 2 characters, just as
	// a demo) - #15 will be 1 if they match, otherwise 0 on the first mismatch.
	movi u32 #15 1
	load u8 #0 160
	load u8 #14 400
	cmp u8 #0 #14
	jz cmp1_ok
	movi u32 #15 0
cmp1_ok:
	load u8 #0 161
	load u8 #14 401
	cmp u8 #0 #14
	jz cmp2_ok
	movi u32 #15 0
cmp2_ok:
	print u32 #15            // expected: 1 (the text matches)


// --- 4) FSCREATE + FSOPEN + FSWRITEB + FSCLOSE: binary write --------------

	movi u32 #1 140          // #1 = address of "data.bin"
	fscreate #1

	fsopen #1
	movi u32 #2 300          // #2 = address of the 4 raw bytes
	movi u32 #4 4            // #4 = length in bytes
	fswriteb #1 #2 #4 #6     // #6 = status
	print u32 #6             // expected: 1
	fsclose #1


// --- 5) FSOPEN + FSREADB + FSCLOSE: read the binary data back -----------------

	fsopen #1
	movi u32 #3 500          // #3 = buf_addr
	movi u32 #4 16           // #4 = buf_size
	fsreadb #1 #3 #4 #5 #6   // #5 = dst_len, #6 = status
	print u32 #5             // expected: 4
	print u32 #6             // expected: 1
	fsclose #1

	// Print the bytes that were read (should be 00, 01, FE, FF)
	load u8 #0 500
	print u8 #0
	load u8 #0 501
	print u8 #0
	load u8 #0 502
	print u8 #0
	load u8 #0 503
	print u8 #0


// --- 6) FSCREATE + FSRM: create and immediately delete a temporary file ------------------

	movi u32 #1 195          // #1 = address of "tmp.txt"
	fscreate #1
	fsrm #1
	// fsrm also has no status register (just like svfs_rm()).


// --- 7) FSMKDIR + FSRMDIR: create and immediately delete a temporary (empty) directory ----

	movi u32 #1 210          // #1 = address of "trash"
	fsmkdir #1
	movi u32 #7 0            // recursive = 0 (the directory is empty, not needed)
	fsrmdir #1 #7
	// fsrmdir is also without a status (just like svfs_rmdir()).


// --- 8) FSCD: enter "docs", create a file inside it, read its contents -----

	movi u32 #1 100          // #1 = address of "docs"
	fscd #1 #6               // #6 = status
	print u32 #6             // expected: 1

	movi u32 #1 220          // #1 = address of "inner.txt" (now relative to "docs")
	fscreate #1

	movi u32 #3 600          // #3 = buf_addr for fsdir
	movi u32 #4 5            // #4 = max_entries
	fsdir #3 #4 #5 #6        // #5 = dst_count, #6 = status
	print u32 #5             // expected: 3 ( . .. inner.txt )
	print u32 #6             // expected: 1

	// Read each record: for each one print its attribute (0=file,1=directory,2=hidden)
	// and its size in bytes (u32 at offset 48). For the record format, see
	// OP_SVFS_DIR in vm.h.
	movi u32 #8 0            // i = 0
	mov #9 #5                // count = dst_count
	movi u32 #7 64           // constant 64 (size of one record)
dir_loop:
	cmp u32 #8 #9
	jge dir_loop_end

	mov #12 #8
	mul u32 #12 #7           // #12 = i * 64
	mov #10 #3
	add u32 #10 #12          // #10 = buf_addr + i*64 = rec_addr

	mov #13 #10
	addi u32 #13 44          // attribute offset
	loadr u8 #11 #13
	print u32 #11            // this entry's attribute

	mov #13 #10
	addi u32 #13 48          // size offset (u32)
	loadr u32 #11 #13
	print u32 #11            // this entry's size in bytes

	inc u32 #8
	jmp dir_loop
dir_loop_end:


// --- 9) FSCD ".." + FSDIR: back to the root, verify that "docs" is visible there ------

	movi u32 #1 180          // #1 = address of ".."
	fscd #1 #6
	print u32 #6             // expected: 1

	movi u32 #3 600
	movi u32 #4 5
	fsdir #3 #4 #5 #6
	print u32 #5             // expected: 5 ( . .. docs notes.txt data.bin )
	print u32 #6             // expected: 1


// --- 10) FSCD "/": explicitly park the running program at the root -----------
//
// IMPORTANT: when SVFS is saved, it also remembers the CURRENT directory (so
// that the next process which loads the disk continues exactly where cd last
// left off - see svfs_save()/svfs_load()). If we ended the program while
// inside "docs" (after step 8) without this return, the next "svfscli
// disk.img ls" (without a path) would show the contents of "docs", NOT the
// root - which at first glance looks like the disk has "disappeared", even
// though everything is completely fine (just check with "ls /"). That's why
// we ALWAYS return to the root at the end.

	movi u32 #1 190          // #1 = address of "/"
	fscd #1 #6
	print u32 #6             // expected: 1

	halt

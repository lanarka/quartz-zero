	store u16 0x45D6 #7

// --- prepare for drawing ------------------------------------------
	movi u32 #4 0xFFFFFFFF   // fg = white, opaque
	movi u32 #5 0xFF000000   // bg = black, opaque
	xtgetres #2 #1           // #2 = rows, #1 = cols (dynamic, NOT hardcoded to 80!)
	movi u32 #0 0            // i = 0
	movi u32 #6 0x4000     // cp_addr = start of the code point buffer

draw_loop:
	cmpi u32 #0 748
	jge draw_done

	loadr u16 #7 #6          // #7 = code point at RAM[#6]

	mov #8 #0
	div u32 #8 #1             // #8 = i / cols  (row)
	mov #9 #0
	mod u32 #9 #1             // #9 = i % cols  (col)

	xtchar #9 #8 #7 #4 #5     // draw the character at (col,row)

	addi u32 #6 2             // next code point (2 bytes/char)
	addi u32 #0 1             // i++
	jmp draw_loop

draw_done:
idle:
	xvsync 0
	jmp idle

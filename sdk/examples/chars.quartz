// ============================================================================
// chars.quartz - prints all 748 characters (glyphs) available in the font,
// character by character, black background / white text, laid out according
// to the actual number of columns (xtgetres) - NOT hardcoded to 80.
//
// The code points are not a contiguous range (e.g. they skip 127-159), so
// they are written here exactly as they really are in the font (loaded
// directly from codepoints.c) - each one stored into the RAM buffer at
// 0x4000 (2 bytes/char, u16 LE), and then drawn one by one in a loop via
// txt_char, with the position (x,y) computed from the index using DIV/MOD
// with the current number of columns.
//
// After printing all characters the demo just waits (xvsync + jmp) - it
// keeps running until the window is closed, so you have time to look at
// everything at your leisure.
// ============================================================================

// --- register map -----------------------------------------------------
// #0  i           (index of the current character, 0..747)
// #1  cols        (number of columns in the text grid, from xtgetres)
// #2  rows        (number of rows, from xtgetres - filled in, not used directly)
// #4  fg          (white, constant)
// #5  bg          (black, constant)
// #6  cp_addr     (running pointer into the RAM buffer of code points)
// #7  scratch     (temporary: loaded code point / while filling the buffer)
// #8  row         (i / cols, temporary)
// #9  col         (i % cols, temporary)

// --- fill the RAM buffer with all 748 code points of the font -----------
	movi u16 #7 32
	store u16 0x4000 #7
	movi u16 #7 33
	store u16 0x4002 #7
	movi u16 #7 34
	store u16 0x4004 #7
	movi u16 #7 35
	store u16 0x4006 #7
	movi u16 #7 36
	store u16 0x4008 #7
	movi u16 #7 37
	store u16 0x400A #7
